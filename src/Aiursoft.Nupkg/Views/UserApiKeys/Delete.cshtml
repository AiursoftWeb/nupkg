@using Aiursoft.WebTools
@model Aiursoft.Nupkg.Models.UserApiKeysViewModels.DeleteViewModel
@{
    var now = DateTime.UtcNow;
    var isExpired = Model.Key.ExpiresAt.HasValue && Model.Key.ExpiresAt <= now;
}

<div class="container-fluid p-0">
    <div class="row mb-3">
        <div class="col-auto">
            <h1 class="h3 mb-1">@Localizer["Revoke API Key"]</h1>
            <p class="text-muted mb-0">@Localizer["Permanently disable this credential so it can no longer authenticate."]</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 col-lg-5">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@Localizer["Confirm Revocation"]</h5>
                </div>
                <div class="card-body">
                    <div class="border rounded p-3 mb-3 bg-body-tertiary">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <strong class="text-break">@Model.Key.Name</strong>
                            @if (isExpired)
                            {
                                <span class="badge bg-danger">@Localizer["Expired"]</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@Localizer["Active"]</span>
                            }
                        </div>
                        <div class="row g-2 small">
                            <div class="col-6">
                                <div class="text-muted">@Localizer["Key Prefix"]</div>
                                <code>@(Model.Key.KeyPrefix)&#8230;</code>
                            </div>
                            <div class="col-6">
                                <div class="text-muted">@Localizer["Total Calls"]</div>
                                <div class="fw-semibold">@Model.Key.TotalUses.ToString("N0")</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted">@Localizer["Expires"]</div>
                                @if (Model.Key.ExpiresAt.HasValue)
                                {
                                    <label class="mb-0" data-utc-time="@Model.Key.ExpiresAt.Value.ToHtmlDateTime()"></label>
                                }
                                else
                                {
                                    <span>@Localizer["No expiration"]</span>
                                }
                            </div>
                            <div class="col-6">
                                <div class="text-muted">@Localizer["Last Used"]</div>
                                @if (Model.Key.LastUsedAt.HasValue)
                                {
                                    <label class="mb-0" data-utc-time="@Model.Key.LastUsedAt.Value.ToHtmlDateTime()"></label>
                                }
                                else
                                {
                                    <span class="text-muted">@Localizer["Never"]</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-danger" role="alert">
                        <div class="alert-icon">
                            <i data-lucide="shield-alert" aria-hidden="true"></i>
                        </div>
                        <div class="alert-message">
                            @Localizer["This action cannot be undone. Clients and pipelines using this key will immediately lose access."]
                        </div>
                    </div>

                    <form asp-action="Delete" asp-route-id="@Model.Key.Id" method="post" class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="align-middle me-1" data-lucide="trash-2" aria-hidden="true"></i>
                            @Localizer["Revoke Key"]
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
