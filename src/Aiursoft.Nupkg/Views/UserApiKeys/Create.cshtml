@model Aiursoft.Nupkg.Models.UserApiKeysViewModels.CreateViewModel
<h1 class="h3">@Localizer["New API key"]</h1>
<div class="row"><div class="col-lg-6"><div class="card"><div class="card-body">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="@Localizer["e.g. CI pipeline"]" autofocus /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="ExpirationDays" class="form-label"></label><select asp-for="ExpirationDays" class="form-select"><option value="7">@Localizer["7 days"]</option><option value="30">@Localizer["30 days"]</option><option value="365">@Localizer["1 year"]</option><option value="3650">@Localizer["10 years"]</option><option value="0">@Localizer["Never"]</option></select><span asp-validation-for="ExpirationDays" class="text-danger"></span></div>
        <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">@Localizer["Generate key"]</button><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a></div>
    </form>
</div></div></div></div>
