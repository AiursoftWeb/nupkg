@model Aiursoft.Nupkg.Views.Shared.Components.MarketingFooter.MarketingFooterViewModel
@using Microsoft.AspNetCore.Localization
<footer class="registry-footer">
    <div class="container">
        <div class="registry-footer-grid">
            <div>
                <a class="registry-brand" asp-controller="Home" asp-action="Index">
                    <img src="@Model.LogoUrl" alt="" />Aiursoft Nupkg</a>
                <p>@Localizer["An open-source NuGet registry for your packages, your team, and your infrastructure."]</p>
            </div>
            <div class="registry-footer-links">
                <a asp-route="PackageCatalog">@Localizer["Browse packages"]</a>
                <a href="https://github.com/aiursoftweb/nupkg">@Localizer["Source code"]</a>
                <a href="https://github.com/aiursoftweb/nupkg/issues">@Localizer["Report an issue"]</a>
                <a href="https://github.com/aiursoftweb/nupkg/blob/master/LICENSE">@Localizer["MIT License"]</a>
            </div>
        </div>
        <div class="registry-footer-bottom">
            <span>© @DateTime.Now.Year <a href="@Model.BrandHomeUrl">@Model.BrandName</a>
                @if (!string.IsNullOrWhiteSpace(Model.Icp) && System.Globalization.CultureInfo.CurrentCulture.Name == "zh-CN")
                { <a href="https://beian.miit.gov.cn/">@Model.Icp</a> }
            </span>
            <form asp-controller="Culture" asp-action="Set" method="post" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">
                <label class="visually-hidden" for="landing-culture">@Localizer["Language"]</label>
                <select id="landing-culture" name="culture" onchange="this.form.submit()" class="form-select form-select-sm">
                    @foreach (var culture in Aiursoft.WebTools.OfficialPlugins.LocalizationPlugin.SupportedCultures)
                    { <option value="@culture.Key" selected="@(culture.Key == Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name)">@culture.Value</option> }
                </select>
            </form>
        </div>
    </div>
</footer>
