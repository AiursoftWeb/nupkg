@model Aiursoft.Nupkg.Views.Shared.Components.MarketingNavbar.MarketingNavbarViewModel
<nav class="registry-nav" aria-label="@Localizer["Main navigation"]">
    <div class="container">
        <a class="registry-brand" asp-controller="Home" asp-action="Index">
            <img src="@Model.LogoUrl" alt="" />@Model.ProjectName</a>
        <div class="registry-nav-links">
            <a asp-route="PackageCatalog">@Localizer["Packages"]</a>
            <a href="#quick-start">@Localizer["Get started"]</a>
            <a href="https://github.com/aiursoftweb/nupkg">@Localizer["Source code"]</a>
            <button type="button" class="registry-theme" data-theme-url="@Url.Content("~/api/switch-theme")" aria-label="@Localizer["Toggle color theme"]" aria-pressed="@(Context.Request.Cookies["prefer-dark"] == bool.TrueString ? "true" : "false")">
                <i data-lucide="sun-moon" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</nav>
