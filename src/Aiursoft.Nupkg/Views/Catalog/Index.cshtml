@model Aiursoft.Nupkg.Models.PackagesViewModels.CatalogViewModel
@* ReSharper disable once Razor.SectionNotResolved *@
@section styles { <link rel="stylesheet" href="~/styles/packages.css" asp-append-version="true" /> }
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div><h1 class="h3 mb-1">@Localizer["Packages"]</h1><p class="text-muted mb-0">@Localizer["Find and install NuGet packages from this server."]</p></div>
    <a asp-action="Upload" class="btn btn-primary"><i data-lucide="upload" aria-hidden="true" class="me-1"></i>@Localizer["Upload packages"]</a>
</div>
<div class="card"><div class="card-body">
    <form asp-route="PackageCatalog" method="get" class="row g-2 align-items-end" role="search">
        <div class="col-12 col-lg-4"><label for="package-query" class="form-label">@Localizer["Search packages"]</label><input id="package-query" name="q" value="@Model.Query" class="form-control" type="search" /></div>
        <div class="col-6 col-lg-2"><label for="package-type" class="form-label">@Localizer["Package type"]</label><select id="package-type" name="packageType" class="form-select"><option value="any">@Localizer["All types"]</option><option value="Dependency" selected="@(Model.PackageType == "Dependency")">@Localizer["Library"]</option><option value="DotnetTool" selected="@(Model.PackageType == "DotnetTool")">@Localizer["Tool"]</option><option value="Template" selected="@(Model.PackageType == "Template")">@Localizer["Template"]</option></select></div>
        <div class="col-6 col-lg-2"><label for="package-framework" class="form-label">@Localizer["Framework"]</label><input id="package-framework" class="form-control" name="framework" value="@(Model.Framework == "any" ? "" : Model.Framework)" placeholder="net10.0" /></div>
        <div class="col-8 col-lg-2"><div class="form-check mb-2"><input id="include-prerelease" name="prerelease" value="true" type="checkbox" checked="@Model.Prerelease" class="form-check-input" /><label for="include-prerelease" class="form-check-label">@Localizer["Prerelease"]</label><input type="hidden" name="prerelease" value="false" /></div></div>
        <div class="col-4 col-lg-2"><button type="submit" class="btn btn-primary w-100">@Localizer["Search"]</button></div>
    </form>
</div></div>
@if (Model.Packages.Count == 0)
{
    <div class="card"><div class="card-body text-center py-5"><h2 class="h4">@Localizer["No packages found"]</h2><p class="text-muted">@Localizer["Try another search or upload a package to this server."]</p><a asp-route="PackageCatalog" class="btn btn-outline-primary">@Localizer["Browse all packages"]</a></div></div>
}
else
{
    <p class="text-muted mb-2">@Localizer["{0} packages", Model.TotalHits]</p>
    <div class="card"><div class="list-group list-group-flush">
    @foreach (var package in Model.Packages)
    {
        <a asp-route="PackageDetails" asp-route-id="@package.PackageId" asp-route-q="@Model.Query" asp-route-page="@Model.Page" asp-route-packageType="@Model.PackageType" asp-route-framework="@Model.Framework" asp-route-prerelease="@Model.Prerelease" class="list-group-item list-group-item-action py-3">
            <div class="d-flex flex-wrap gap-2 align-items-baseline"><h2 class="h5 mb-0 text-break">@package.PackageId</h2><span class="text-muted">@package.Version</span></div>
            <p class="my-2 text-break">@package.Description</p><small class="text-muted">@string.Join(", ", package.Authors ?? [])</small>
        </a>
    }
    </div></div>
}
@if (Model.TotalPages > 1 || Model.Page > 1)
{
    <nav aria-label="@Localizer["Package pages"]" class="d-flex flex-wrap gap-2 align-items-center justify-content-center">
    @if (Model.Page > 1) { <a class="btn btn-outline-secondary" asp-route="PackageCatalog" asp-route-q="@Model.Query" asp-route-page="@(Model.Page - 1)" asp-route-packageType="@Model.PackageType" asp-route-framework="@Model.Framework" asp-route-prerelease="@Model.Prerelease">@Localizer["Previous"]</a> }
    <span aria-current="page">@Localizer["Page {0} of {1}", Model.Page, Math.Max(1, Model.TotalPages)]</span>
    @if (Model.Page < Model.TotalPages) { <a class="btn btn-outline-secondary" asp-route="PackageCatalog" asp-route-q="@Model.Query" asp-route-page="@(Model.Page + 1)" asp-route-packageType="@Model.PackageType" asp-route-framework="@Model.Framework" asp-route-prerelease="@Model.Prerelease">@Localizer["Next"]</a> }
    </nav>
}
