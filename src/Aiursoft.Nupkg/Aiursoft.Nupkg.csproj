<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.Nupkg</AssemblyName>
    <RootNamespace>Aiursoft.Nupkg</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Aiursoft.ClickhouseLoggerProvider" Version="10.0.30" />
    <PackageReference Include="Aiursoft.DbTools.Switchable" Version="10.0.31" />
    <PackageReference Include="Aiursoft.Scanner" Version="10.0.16" />
    <PackageReference Include="Aiursoft.UiStack" Version="10.0.45" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="4.156.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.Canon.ScheduledTasks" Version="10.0.19" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aiursoft.Nupkg.InMemory\Aiursoft.Nupkg.InMemory.csproj" />
    <ProjectReference Include="..\Aiursoft.Nupkg.MySql\Aiursoft.Nupkg.MySql.csproj" />
    <ProjectReference Include="..\Aiursoft.Nupkg.Sqlite\Aiursoft.Nupkg.Sqlite.csproj" />
    <ProjectReference Include="..\Aiursoft.Nupkg.Core\Aiursoft.Nupkg.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../BAGET-LICENSE" Link="BAGET-LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-NOTICES" Link="THIRD-PARTY-NOTICES" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
