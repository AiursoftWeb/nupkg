[Unit]
Description=Aiursoft Nupkg Web Application
After=network.target

[Service]
WorkingDirectory=/usr/share/aiursoft-nupkg
ExecStart=/usr/bin/dotnet /usr/share/aiursoft-nupkg/Aiursoft.Nupkg.dll --urls http://*:5000
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=aiursoft-nupkg
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=HOME=/var/lib/aiursoft-nupkg

[Install]
WantedBy=multi-user.target
