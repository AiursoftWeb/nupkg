<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.Nupkg.Core</AssemblyName>
    <RootNamespace>Aiursoft.Nupkg.Core</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>The core libraries that power Nupkg.</Description>
    <PackageTags>NuGet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageReference Include="NuGet.Protocol" Version="8.0.0" />
    <!-- Override NuGet.Packaging's vulnerable transitive dependency until upstream updates it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aiursoft.Nupkg.Protocol\Aiursoft.Nupkg.Protocol.csproj" />
    <ProjectReference Include="..\Aiursoft.Nupkg.Entities\Aiursoft.Nupkg.Entities.csproj" />
  </ItemGroup>
</Project>
